---
import PageLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SkillLayout from "@/components/SkillLayout.astro";
import PostPreview from "@/components/PostPreview.astro";

import { Image } from "astro:assets";
import astro from "@/assets/social-card.png";

import { getAllPosts, sortMDByDate } from "@/utils";
import Link from "@/components/Link.astro";

const languages = ["Javascript/Typescript", "C", "PHP", "C#", "Bash"];
const frontend = [
    "HTML",
    "CSS",
    "SASS",
    "TailwindCSS",
    "Boostrap",
    "Fresh",
    "React",
    "Astro",
    "Markdown",
    "SvelteKit",
];
const backend = [
    "Node.js",
    "NextJS",
    "Deno",
    "GraphQL",
    "MongoDB",
    "MySQL",
    "PostgreSQL",
    "ASP.NET Core",
    "Express.js",
    "Hono",
    "tRPC",
];
const others = [
    "AWS",
    "GCP",
    "DevOps",
    "Blender",
    "Unity",
    "Stride3d",
    "Git",
    "CI/CD",
    "Godot",
    "JAMStack",
    "Tanstack",
    "SWR",
    "Zustand",

    "Websockets",
    "WebRTC",
    "CMS Integration",
    "API Design",
];
const mobile = ["Flutter", "React Native"];

const MAX_POSTS = 10;
const allPosts = await getAllPosts();
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS);
---

<PageLayout
    meta={{
        title: "Home",
        description:
            "Abdulkareem Ojerinde - Fullstack Developer specializing in Web and Game Development",
    }}
>
    <div class="flex w-full flex-col gap-y-12 md:gap-y-16">
        <section class="flex flex-col items-center gap-y-8">
            <Image
                src={astro}
                alt="profile photo"
                class="h-40 w-auto rounded-full p-2 shadow-md transition-transform duration-300 hover:scale-105"
                loading="eager"
            />

            <div class="flex flex-col items-center gap-y-4">
                <h1 class="text-4xl font-bold tracking-tight">Hello There!</h1>
                <a
                    href="https://github.com/abdulkareemoj"
                    class="border-border flex flex-row items-center gap-x-3 rounded-3xl border px-4 py-2 text-sm shadow-sm transition-all duration-300 hover:shadow-md hover:translate-y-[-2px] hover:border-accent"
                >
                    <span class="relative flex items-center justify-center">
                        <span class="absolute inline-flex h-2 w-2 animate-ping rounded-full border border-accent bg-accent opacity-75"></span>
                        <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
                    </span>

                    <p class="font-semibold">Available</p>
                </a>
            </div>
        </section>

        <Section title="About">
            <p>
                <small>IPA /ˈwiztek/, no meaning, I made it up</small>
                <br />
                Hi, I'm <strong>Abdulkareem</strong> (aka{" "}
                <strong>WiZtEk</strong>). I'm a Fullstack Developer focused on{" "}
                <strong>Web</strong> and
                <strong> Game Development</strong>. For web I work with
                <a class="hover:underline" href="https://nextjs.org">
                    {" "}
                    Next.js
                </a>
                ,
                <a class="hover:underline" href="https://kit.svelte.dev">
                    {" "}
                    SvelteKit
                </a>
                ,
                <a class="hover:underline" href="https://nodejs.org">
                    {" "}
                    Node.js
                </a>
                ,
                <a class="hover:underline" href="https://hono.dev">
                    {" "}
                    Hono
                </a>
                , and
                <a class="hover:underline" href="https://deno.com">
                    {" "}
                    Deno
                </a>
                . For games,
                <a class="hover:underline" href="https://www.unrealengine.com/">
                    {" "}
                    Unreal Engine
                </a>
                ,
                <a class="hover:underline" href="https://godot.com">
                    {" "}
                    Godot
                </a>
                , and
                <a class="hover:underline" href="https://blender.org">
                    {" "}
                    Blender
                </a>
                . Also exploring <strong>C#</strong> with
                <a
                    class="hover:underline"
                    href="https://dotnet.microsoft.com/en-us/apps/aspnet"
                >
                    {" "}
                    ASP.NET
                </a>
                .
            </p>

            <p class="mb-4">
                Currently building
                <a
                    href="https://foreum.vercel.app/"
                    target="_blank"
                    class="hover:underline font-semibold"
                >
                    {" "}
                    Foreum
                </a>
                , a self-hostable community platform; an{" "}
                <a
                    href="https://email-builder-psi-six.vercel.app/"
                    target="_blank"
                    class="hover:underline font-semibold"
                >
                    Email Template Builder
                </a>
                ; and{" "}
                <a
                    href="https://freader-website.vercel.app/"
                    target="_blank"
                    class="hover:underline font-semibold"
                >
                    freader
                </a>
                , a multi-platform ebook reader.
            </p>
        </Section>

        <Section title="Projects">
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                <ProjectCard
                    href="/projects/readrsync"
                    heading="ReadrSync"
                    subheading="A personal cross-platform bookmark and RSS reader app built for desktop, web, and mobile."
                    imagePath="https://res.cloudinary.com/dcc1yy1zv/image/upload/v1785858170/www/bookmarks_lv9tbc.png"
                    altText="Example"
                />
                <ProjectCard
                    href="/projects/clipapp"
                    heading="MyClipApp"
                    subheading="A Windows screen-capture tool."
                    imagePath="https://res.cloudinary.com/dcc1yy1zv/image/upload/v1793188249/www/4af2fec9-286d-4d23-9ebc-9b467d001fdd.png"
                    altText="Example"
                />
                <ProjectCard
                    href="/projects/freader"
                    heading="Freader"
                    subheading="A cross-platform ebook reader app."
                    imagePath="https://res.cloudinary.com/dcc1yy1zv/image/upload/v1795135492/www/Screenshot_2026-11-20_011105_l978s2.png"
                    altText="Example"
                />
                <ProjectCard
                    href="/projects/billy"
                    heading="Billy"
                    subheading="Propery Management Platform MVP"
                    imagePath="https://res.cloudinary.com/dcc1yy1zv/image/upload/v1785156081/www/Screenshot_27-7-2026_134029_billy-frontend.vercel.app_kvbhxd.jpg"
                    altText="Example"
                />
                <ProjectCard
                    href="/projects/e-commerce"
                    heading="Multivendor E‑commerce Platform"
                    subheading="Modern multivendor e-commerce platform with React Native mobile app and Hono backend"
                    imagePath="https://res.cloudinary.com/dcc1yy1zv/image/upload/v1784817004/www/marketplace_n2almj.webp"
                    altText="Example"
                />
                <ProjectCard
                    href="/projects/foreum"
                    heading="Foreum"
                    subheading="A powerful, modern forum platform built with Tanstack Start, tRPC, and Drizzle ORM"
                    imagePath="https://res.cloudinary.com/dcc1yy1zv/image/upload/v1759321228/www/Screenshot_2025-09-30_at_21-58-49_Foreum_-_Modern_Forum_Platform_for_Your_Website_scnops.png"
                    altText="Lorem, ipsum dolor sit"
                />
            </div>
            <div class="pt-2">
                <Link
                    href="/projects"
                    class="ptransition-colors duration-300 hover:text-accent"
                >
                    All projects →
                </Link>
            </div>
        </Section>

        {allPostsByDate.length > 0 && (
            <>
                <Section title="Posts">
                    <ul class="flex flex-col gap-y-3">
                        {allPostsByDate.map((p) => (
                            <li class="flex flex-col gap-x-2 sm:flex-row transition-colors duration-300 hover:text-accent">
                                <PostPreview post={p} />
                            </li>
                        ))}
                    </ul>
                </Section>{" "}
                <div class="pt-2 flex justify-start">
                    <Link
                        href="/blog"
                        class="transition-colors duration-300 hover:text-accent"
                    >
                        All posts →
                    </Link>
                </div>
            </>
        )}

        <Section title="Skills">
            <SkillLayout title="Languages" skills={languages} />
            <SkillLayout title="Frontend" skills={frontend} />
            <SkillLayout title="Backend" skills={backend} />
            <SkillLayout title="Others" skills={others} />
            <SkillLayout title="Mobile" skills={mobile} />
        </Section>
    </div>
</PageLayout>
