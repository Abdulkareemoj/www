---
import { cn } from "@lib/utils";

const {
  class: className,
  as: Tag = "div",
  title,
  href,
  ...props
} = Astro.props;
---

<Tag
  class={cn(
    className,
    "flex flex-row items-center justify-center gap-x-2",
    href && "hover:opacity-75 transition-opacity duration-200 ease-out-custom",
  )}
  href={href}
  {...props}
>
  <slot name="icon" />
  <p>{title}</p>
</Tag>
